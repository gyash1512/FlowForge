# ── PostgreSQL ──
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_DB=conduit
POSTGRES_PORT=5432

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=conduit

# ── Worker ──
WORKER_PORT=4000
WORKER_CONCURRENCY=10

# ── Integration Service ──
INTEGRATION_PORT=4001
GRPC_PORT=50051

# ── Dashboard ──
DASHBOARD_PORT=3000
CONDUIT_API_KEY=

# ── Nango (OAuth integration proxy) ──
NANGO_PORT=3003
NANGO_SECRET_KEY=nango-secret
NANGO_DB_NAME=nango

# ── Logging ──
LOG_LEVEL=info
