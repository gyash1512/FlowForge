{
  "name": "@flowforge/nodes",
  "version": "0.1.1",
  "private": true,
  "description": "Built-in node definitions for FlowForge workflow engine",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@composio/core": "^0.6.8",
    "@e2b/code-interpreter": "^1.0.4",
    "@flowforge/shared": "workspace:*",
    "@flowforge/sdk": "workspace:*",
    "cheerio": "^1.0.0",
    "duck-duck-scrape": "^2.2.5",
    "execa": "^9.5.0",
    "mathjs": "^14.0.0",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^24.0.0",
    "simple-git": "^3.27.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
