{
  "name": "@flowforge/worker",
  "version": "0.1.0",
  "description": "BullMQ-based worker service with Hono HTTP API for FlowForge",
  "type": "module",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@flowforge/shared": "workspace:*",
    "@flowforge/engine": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "hono": "^4.4.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.0",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0",
    "pino": "^9.3.0",
    "croner": "^8.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.24.0",
    "zod": "3.23.8"
  }
}
